   ProjectManagerOnly;
   RoleGated;
 };
type AIAFormEntry = 
 record {
   fieldData: vec record {
                    text;
                    text;
                  };
   formType: FormType;
   id: text;
   lastModified: int;
   sessionId: text;
   submittedAt: int;
   submittedByRole: text;
 };
service : {
  activateSubscription: (stripeSubscriptionId: text) -> (Result_1);
  addDrawing: (name: text, category: DrawingCategory, fileType:
   DrawingFileType, storageKey: text, description: text) -> (Drawing);
  addNCCERCertification: (participantId: text, trade: text, discipline: 
   text, level: text, state: text, certNumber: text, issuedAt: int,
   expiresAt: int) -> (NCCERCertShared);
  addPaymentMethod: (setupIntentId: text) -> (Result_1);
  addRenewalHistoryEntry: (entry: RenewalHistoryEntry) -> (Result);
  applyProjectTemplate: (categoryId: text, subtopicId: text) ->
   (ApplyTemplateResult);
  approveCriticalChangePlan: (planId: text, approved: bool) ->
   (CriticalPlanApproval);
  approveDocumentReview: (user: principal, documentType: text) -> (Result);
  approveParticipant: (id: text) -> (opt Participant);
  assignAdmin: (p: principal) -> (Result);
  assignParticipantToPhaseCode: (assignment: ParticipantAssignment) ->
   (ParticipantAssignment);
  autoLinkStandardsForCategory: (projectCategory: text, projectSubtype: 
   text, state: opt text) -> (vec text);
  canAccessCompliance: (role: ParticipantRole) -> (bool) query;
  canManageCriticalPlans: (role: ParticipantRole) -> (bool) query;
  cancelTrial: () -> (Result);
  changePassword: (email: text, currentPassword: text, newPassword: text) ->
   (Result);
  /// One-time claim: the first caller who finds _controller == anonymous
  /// principal becomes the permanent controller.  Secure because the
  /// deployer is the only one who can call this before any user interaction.
  claimController: () -> (Result);
  compareScenarios: (ids: vec text) -> (vec ScenarioCashProjection) query;
  computeCriticalPath: (phases: vec CPMPhaseInput) ->
   (vec CriticalPathNode) query;
  computeResourceSummaries: (originalBaselineMultiplier: float64,
   crashedBaselineMultiplier: float64) -> (vec ResourceSummary) query;
  createCriticalChangePlan: (name: text, phaseIds: vec text, csiCodes:
   vec text, hazardAnalysis: text, controlMeasures: text,
   affectedStandardIds: vec text, responsibleParticipantIds: vec text) ->
   (CriticalChangePlanShared);
  createOACSession: (date: text, time: text) -> (text);
  createParticipant: (participant: Participant) -> (Participant);
  createReviewRequest: (drawingId: text, notes: text) ->
   (opt record {
          ReviewRequest;
          DrawingNotification;
        });
  createScenario: (req: CreateScenarioRequest) ->
   (variant {
      err: text;
      ok: Scenario;
    });
  deactivateShareLink: (token: text) -> (bool);
  deleteCostCode: (phaseId: nat, codeId: nat) -> (variant {
                                                    err: text;
                                                    ok;
                                                  });
  deleteDrawing: (id: text) -> (bool);
  deleteParticipant: (id: text) -> (bool);
  deletePhase: (phaseId: nat) -> (bool);
  deletePhaseAllocation: (id: text) -> (bool);
  deleteResource: (id: text) -> (bool);
  deleteReviewRequest: (id: text) -> (bool);
  deleteScenario: (id: text) -> (variant {
                                   err: text;
                                   ok;
                                 });
  dismissDrawingNotification: (id: text) -> (bool);
  dismissReminder: (day: nat) -> ();
  emailLogin: (email: text, password: text, userAgent: text, ipAddress:
   text) -> (Result_4);
  endSession: (sessionId: text) -> ();
  enrollTrial: (tier: SubscriptionTier, stripeCustomerId: text,
   stripePaymentMethodId: text) -> (Result_1);
  expireSubscription: () -> (Result);
  fetchRSMeansBenchmarks: (csiDivision: text) -> (text);
  generateResetCode: (email: text) -> (Result_3);
  generateShareLink: (projectId: text) -> (ShareLink);
  generateZoomMeeting: (sessionId: text, topic: text) -> (ZoomMeetingResult);
  getAIAForm: (formId: text) -> (opt AIAFormEntry) query;
  getAIAForms: (sessionId: text) -> (vec AIAFormEntry) query;
  getActiveFilter: () -> (opt text, opt text) query;
  getActiveSessions: () -> (vec SessionSnapshot) query;
  getAdminList: () -> (vec AdminRole) query;
  getAppSettings: () -> (AppSettings) query;
  getBankAccount: () -> (opt BankAccount) query;
  getCertificationsForPhase: (phaseId: text) -> (vec NCCERCertShared) query;
  getComplianceItemsForPhase: (phaseId: text) ->
   (vec ComplianceItemShared) query;
  getControllerProfile: () -> (Result_2) query;
  getCostCodeCompletion: (phaseId: nat, codeId: nat) -> (opt float64) query;
  getCostCodesForPhase: (phaseId: nat) ->
   (variant {
      err: text;
      ok: vec CostCode__1;
    }) query;
  getCriticalChangePlansForPhase: (phaseId: text) ->
   (vec CriticalChangePlanShared) query;
  getCumulativeCashRequirement: () -> (vec CumulativePoint) query;
  getCumulativeCrashedRequirement: () -> (vec CumulativePoint) query;
  getCumulativeWithBreakdown: () -> (vec CumulativePointWithCodes) query;
  getDocumentReviewStatus: () -> (vec VerificationDocument) query;
  getDrawingNotifications: () -> (vec DrawingNotification) query;
  getDrawings: () -> (vec Drawing) query;
  getEarnedValueMetrics: (baselineType: BaselineType) -> (vec EVMPoint) query;
  getFeatureLocks: () -> (FeatureLockSnapshot) query;
  getFilteredStandards: (projectCategory: text, projectSubtype: text, state:
   opt text) -> (vec SafetyStandard) query;
  getIdleTimeSetting: () -> (opt IdleTimeSetting) query;
  getLoginHistory: () -> (vec SessionSnapshot) query;
  getNCCERCertificationsForParticipant: (participantId: text) ->
   (vec NCCERCertShared) query;
  getNextPayoutDate: () -> (opt text) query;
  getOACSession: (id: text) -> (opt OACMeetingSession) query;
  getOACSessions: () -> (vec OACMeetingSession) query;
  getParticipant: (id: text) -> (opt Participant) query;
  getParticipantAssignments: (participantId: text) ->
   (vec ParticipantAssignment) query;
  getParticipantMeetingPackage: (sessionId: text) -> (MeetingPackage) query;
  getParticipants: () -> (vec Participant) query;
  getPaymentMethods: () -> (vec PaymentMethodInfo) query;
  getPayoutRecords: () -> (vec PayoutRecord) query;
  getPhaseAllocations: () -> (vec PhaseAllocation) query;
  getPhaseAllocationsByPhase: (phaseId: text) -> (vec PhaseAllocation) query;
  getPhaseAllocationsByResource: (resourceId: text) ->
   (vec PhaseAllocation) query;
  getPhaseComplianceStatus: (phaseId: text) -> (PhaseComplianceSummary) query;
  getPhases: () -> (vec Phase) query;
  getProjectCategories: () -> (vec ProjectCategory) query;
  getProjectEVMSummary: (baselineType: BaselineType) ->
   (ProjectEVMSummary) query;
  getProjectShareLinks: (projectId: text) -> (vec ShareLink) query;
  getProjectSubtopic: (categoryId: text, subtopicId: text) ->
   (opt ProjectSubtopic) query;
  getRSMeansSettings: () -> (RSMeansSettings) query;
  getReminderState: () -> (opt ReminderState) query;
  getRenewalHistory: () -> (vec RenewalHistoryEntry) query;
  getResources: () -> (vec Resource) query;
  getResourcesByType: (resourceType: ResourceType) -> (vec Resource) query;
  getReviewRequests: () -> (vec ReviewRequest) query;
  getScenario: (id: text) -> (opt Scenario) query;
  getScenarioBenchmarkVariances: (id: text) ->
   (vec ScenarioBenchmarkVariance) query;
  getScenarioCashProjection: (id: text) -> (opt ScenarioCashProjection) query;
  getScenarioEVMSummary: (id: text) -> (opt ScenarioEVMSummary) query;
  getShareLink: (token: text) -> (opt ShareLink) query;
  getSignOffsForPhase: (phaseId: text) -> (vec PhaseSignOffShared) query;
  getStandard: (id: text) -> (opt SafetyStandard) query;
  getStandardsForCsiCode: (csiCode: text) -> (vec SafetyStandard) query;
  getStandardsForPhase: (phaseId: text) -> (vec SafetyStandard) query;
  getSubscriptionStatus: () -> (SubscriptionStatus) query;
  getTrialLinks: () -> (vec TrialLink) query;
  getUserSubscription: () -> (opt UserSubscription) query;
  getZoomSettings: () -> (opt ZoomSettings) query;
  isAdmin: (p: principal) -> (bool) query;
  isController: (p: principal) -> (bool) query;
  isPhaseSignedOff: (phaseId: text) -> (bool) query;
  isPlanFullyApproved: (planId: text) -> (bool) query;
  linkStandardToPhase: (phaseId: text, csiCode: text, standardId: text) ->
   (PhaseStandardLink);
  listScenarios: () -> (vec ScenarioSummary) query;
  registerEmailUser: (email: text, password: text, name: text, phone:
   text) -> (Result);
  rejectParticipant: (id: text) -> (opt Participant);
  removeParticipantAssignment: (participantId: text, phaseId: text,
   costCodeId: text) -> (bool);
  renewSubscription: () -> (Result_1);
  resendPasscode: (id: text) -> (bool);
  revokeAdmin: (p: principal) -> (Result);
  saveAIAForm: (sessionId: text, formType: FormType, fieldData:
   vec record {
         text;
         text;
       }, submittedByRole: text) -> (text);
  saveAppSettings: (settings: AppSettings) -> (AppSettings);
  saveBankAccount: (holderName: text, accountNumberLast4: text,
   routingNumber: text) -> ();
  savePayoutRecords: (records: vec PayoutRecord) -> ();
  saveRSMeansSettings: (settings: RSMeansSettings) -> (RSMeansSettings);
  saveZoomSettings: (settings: ZoomSettings) -> (bool);
  searchStandards: (searchText: text, category: opt StandardCategory, state:
   opt text) -> (vec SafetyStandard) query;
  setActiveFilter: (categoryId: opt text, subtopicId: opt text) -> ();
  setFeatureLock: (feature: text, locked: bool) -> (variant {
                                                      err: text;
                                                      ok;
                                                    });
  setFixedZoomLink: (roleId: text, zoomLink: text) -> (bool);
  setIdleTimeSetting: (mode: IdleTimeMode) -> (IdleTimeSetting);
  setNextPayoutDate: (date: text) -> ();
  setPhases: (inputs: vec PhaseInput) -> ();
  setReminderEmailSent: (day: nat) -> ();
  setStripeSecretKey: (secretKey: text) -> ();
  submitDocumentForReview: (documentType: text, storageKey: text,
   stripeSessionId: opt text) -> (VerificationDocument);
  /// One-time claim: the first caller who finds _controller == anonymous
  /// principal becomes the permanent controller.  Secure because the
  /// deployer is the only one who can call this before any user interaction.
  submitPhaseSignOff: (phaseId: text, approved: bool, comments: text) ->
   (PhaseSignOffShared);
  submitPlanForApproval: (id: text) -> (opt CriticalChangePlanShared);
  switchTrialTier: (newTier: SubscriptionTier) -> (Result_1);
  testRSMeansConnection: () -> (text);
  transform: (input: TransformationInput) -> (TransformationOutput) query;
  unlinkStandardFromPhase: (phaseId: text, csiCode: text, standardId:
   text) -> (bool);
  updateAIAForm: (formId: text, fieldData: vec record {
                                                 text;
                                                 text;
                                               }) -> (bool);
  updateControllerProfile: (name: text, email: text, phone: text) -> (Result);
  updateCostCodeCompletion: (phaseId: nat, codeId: nat, percentComplete:
   float64) -> ();
  updateCriticalChangePlan: (id: text, name: opt text, phaseIds:
   opt vec text, csiCodes: opt vec text, hazardAnalysis: opt text,
   controlMeasures: opt text, affectedStandardIds: opt vec text,
   responsibleParticipantIds: opt vec text) -> (opt CriticalChangePlanShared);
  updateNCCERCertification: (id: text, trade: opt text, discipline: opt text,
   level: opt text, certNumber: opt text, issuedAt: opt int, expiresAt:
   opt int, status: opt NCCERCertStatus) -> (opt NCCERCertShared);
  updateOACSessionZoomLink: (sessionId: text, zoomLink: text, zoomMeetingId:
   text) -> (bool);
  updateParticipant: (updated: Participant) -> (opt Participant);
  updateRSMeansEntry: (participantId: text, phaseId: text, costCodeId: 
   text, updated: ParticipantAssignment) -> (opt ParticipantAssignment);
  updateReviewRequest: (id: text, status: text, notes: text) ->
   (opt ReviewRequest);
  updateScenario: (id: text, req: CreateScenarioRequest) ->
   (variant {
      err: text;
      ok: Scenario;
    });
  upsertComplianceItem: (phaseId: text, standardId: text, status:
   ComplianceStatus, severity: ComplianceSeverity, notes: text) ->
   (ComplianceItemShared);
  upsertCostCode: (phaseId: nat, input: CostCodeInput) ->
   (variant {
      err: text;
      ok: CostCode__1;
    });
  upsertPhase: (phaseId: nat, input: PhaseInput) -> (Phase);
  upsertPhaseAllocation: (input: PhaseAllocationInput) -> (PhaseAllocation);
  upsertResource: (input: ResourceInput) -> (Resource);
  validateResetCode: (email: text, code: text, newPassword: text) -> (Result);
  zoomTransform: (input: TransformationInput) -> (TransformationOutput) query;
}
